{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Jam",
  "colors": {
    "primary": "#171717",
    "light": "#fafafa",
    "dark": "#171717"
  },
  "styling": {
    "codeblocks": {
      "themes": {
        "light": "github-light",
        "dark": "github-dark-dimmed"
      }
    }
  },
  "background": {
    "color": {
      "light": "#FAF9F5",
      "dark": "#1c1c1c"
    }
  },
  "metadata": {
    "og:image": "/images/og-image.png",
    "og:site_name": "Jam Docs",
    "og:description": "Documentation for Jam, the AI growth agent for builders"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 300
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "appearance": {
    "default": "light"
  },
  "rounded": "default",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Core",
            "pages": [
              "core/types",
              "core/registry",
              "core/execution-context",
              "core/utilities"
            ]
          },
          {
            "group": "Built-in Nodes",
            "pages": [
              "nodes/overview",
              "nodes/logic",
              "nodes/transform",
              "nodes/integration",
              "nodes/ai"
            ]
          },
          {
            "group": "Playground",
            "pages": [
              "playground/overview",
              "playground/cli",
              "playground/web"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "creating-nodes",
              "mcp"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.spreadjam.com"
        },
        {
          "anchor": "Blog",
          "href": "https://www.spreadjam.com/blogs"
        },
        {
          "anchor": "Open Source",
          "href": "https://github.com/wespreadjam/jam-nodes"
        },
        {
          "anchor": "Discord",
          "href": "https://dsc.gg/spreadjam"
        },
        {
          "anchor": "npm",
          "href": "https://www.npmjs.com/org/jam-nodes"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "height": 28
  },
  "navbar": {
    "links": [
      {
        "label": "Blog",
        "href": "https://www.spreadjam.com/blogs"
      },
      {
        "label": "Pricing",
        "href": "https://www.spreadjam.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://www.spreadjam.com"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "mcp"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/wespreadjam",
      "github": "https://github.com/wespreadjam",
      "linkedin": "https://www.linkedin.com/company/108739060/",
      "discord": "https://dsc.gg/spreadjam"
    }
  }
}
