{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "jam-nodes",
  "colors": {
    "primary": "#D83A3A",
    "light": "#F10606",
    "dark": "#9C0041"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart", "creating-nodes"]
          },
          {
            "group": "Core API",
            "pages": ["core/types", "core/registry", "core/execution-context", "core/utilities"]
          },
          {
            "group": "Built-in Nodes",
            "pages": ["nodes/overview", "nodes/logic", "nodes/transform", "nodes/integration", "nodes/ai"]
          },
          {
            "group": "Visual Editor",
            "pages": ["editor/overview", "editor/workflow-json", "editor/runner"]
          },
          {
            "group": "AI Integration",
            "pages": ["mcp"]
          },
          {
            "group": "Playground",
            "pages": ["playground/overview", "playground/cli", "playground/web"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/wespreadjam/jam-nodes"
        },
        {
          "anchor": "npm",
          "href": "https://www.npmjs.com/org/jam-nodes"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "height": 40
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "GitHub",
      "href": "https://github.com/wespreadjam/jam-nodes"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "mcp"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/wespreadjam/jam-nodes"
    }
  }
}
